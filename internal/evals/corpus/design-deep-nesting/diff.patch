+package pipeline
+
+func Process(items []int) int {
+	total := 0
+	for _, v := range items {
+		if v > 0 {
+			if v%2 == 0 {
+				if v < 100 {
+					total += v
+				}
+			}
+		}
+	}
+	return total
+}
