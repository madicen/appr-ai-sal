+package db
+
+import (
+	"database/sql"
+	"fmt"
+)
+
+func LookupUser(db *sql.DB, name string) *sql.Row {
+	query := fmt.Sprintf("SELECT * FROM users WHERE name = '%s'", name)
+	return db.QueryRow(query)
+}
