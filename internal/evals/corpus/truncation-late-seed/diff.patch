diff --git a/blob/checksum.go b/blob/checksum.go
new file mode 100644
--- /dev/null
+++ b/blob/checksum.go
@@ -0,0 +1,8 @@
+package blob
+
+import "crypto/md5"
+
+func Checksum(b []byte) []byte {
+	h := md5.Sum(b)
+	return h[:]
+}
